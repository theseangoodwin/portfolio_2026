{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/writing",
      "destination": "/#writing",
      "permanent": true
    },
    {
      "source": "/writing.html",
      "destination": "/#writing",
      "permanent": true
    }
  ]
}
